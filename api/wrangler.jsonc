{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "request-tracker-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "request-tracker",
      "database_id": "f2c93580-7af6-440c-8498-b9b607494fdf",
      "migrations_dir": "migrations"
    }
  ],

  "ai": { "binding": "AI", "remote": true },

  "vars": {
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    // comma separated
    "ALLOWED_ORIGINS": "http://localhost:5173,https://request-tracker-dwi.pages.dev"
  },

  "env": {
    // `wrangler dev --env offline`: no Cloudflare login needed. Bindings are not
    // inherited by environments, so there is no AI binding and triage falls back
    // to manual category selection.
    "offline": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "request-tracker",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
        "ALLOWED_ORIGINS": "http://localhost:5173"
      }
    }
  }
}
